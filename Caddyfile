chpli.com, www.chpli.com {
    # 用户认证 API 路由到 user-manager 服务
    handle_path /api/auth/* {
        reverse_proxy user-manager:3002
    }

    # 业务 API 路由到 calendar-memo server
    handle_path /api/* {
        reverse_proxy server:3001
    }

    # 静态文件 uploads 路由到 calendar-memo server
    handle_path /uploads/* {
        reverse_proxy server:3001
    }

    # 其余请求路由到 portal 前端
    reverse_proxy portal-web:80
}
